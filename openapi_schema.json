{
    "openapi": "3.1.0",
    "info": {
        "title": "CV Project API",
        "description": "API for managing CV experience entries, summary, portfolio, and role via Supabase RPC.",
        "version": "1.4.0"
    },
    "servers": [
        {
            "url": "https://nkxsrltafwuygqbyebxc.supabase.co"
        }
    ],
    "paths": {
        "/rest/v1/rpc/gpt_manage_entries": {
            "post": {
                "operationId": "manageCV",
                "summary": "Get or Update CV experience, summary, portfolio, and role.",
                "description": "Reads current CV data or performs a FULL UPDATE (Replace) of entries, summary, portfolio, and role.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "p_project_id": {
                                        "type": "string",
                                        "description": "The UUID Project Token."
                                    },
                                    "action": {
                                        "type": "string",
                                        "enum": [
                                            "get_entries",
                                            "update_skills",
                                            "update_profile",
                                            "add_entry",
                                            "update_entry",
                                            "delete_entry"
                                        ],
                                        "description": "Action to perform."
                                    },
                                    "p_entry_data": {
                                        "type": "object",
                                        "description": "Payload for the action. For 'update_skills', pass array of strings. For 'update_profile', pass object with summary, role, etc. For 'add/update_entry', pass experience object.",
                                        "properties": {
                                            "skills": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                },
                                                "description": "List of skills (for update_skills)."
                                            },
                                            "role": {
                                                "type": "string"
                                            },
                                            "company": {
                                                "type": "string"
                                            },
                                            "period": {
                                                "type": "string"
                                            },
                                            "description": {
                                                "type": "string"
                                            },
                                            "summary": {
                                                "type": "string"
                                            },
                                            "portfolio": {
                                                "type": "string"
                                            },
                                            "id": {
                                                "type": "string",
                                                "description": "UUID of entry to update/delete."
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "p_project_id",
                                    "action"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "full_name": {
                                            "type": "string"
                                        },
                                        "role": {
                                            "type": "string"
                                        },
                                        "summary": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        },
                                        "phone": {
                                            "type": "string"
                                        },
                                        "location": {
                                            "type": "string"
                                        },
                                        "linkedin": {
                                            "type": "string"
                                        },
                                        "portfolio": {
                                            "type": "string"
                                        },
                                        "skills": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "languages": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "education": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "courses": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "entries": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "company": {
                                                        "type": "string"
                                                    },
                                                    "role": {
                                                        "type": "string"
                                                    },
                                                    "period": {
                                                        "type": "string"
                                                    },
                                                    "description": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "message": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}